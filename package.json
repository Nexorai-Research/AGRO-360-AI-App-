{
  "name": "agro360-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "decimal.js": "^10.6.0",
    "expo": "~58.0.23",
    "expo-application": "~58.1.2",
    "expo-auth-session": "~58.0.17",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.20",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "i18next": "^27.1.1",
    "react": "19.3.0",
    "react-i18next": "^18.0.1",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "react-test-renderer": "^19.3.0",
    "test-renderer": "1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --forceExit",
    "format": "prettier --write .",
    "gen:api": "node scripts/gen-api-types.mjs",
    "gen:i18n": "node scripts/gen-i18n.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|expo-.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@tanstack/.*|standard-navigation))"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.claude/"
    ],
    "testTimeout": 30000
  }
}
